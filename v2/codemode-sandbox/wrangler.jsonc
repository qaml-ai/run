{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "camelrun-v2-codemode-sandbox",
  "main": "src/index.ts",
  "account_id": "85bbd288051330fb51ee1c86031a299b",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "code_update_strategy": {
      "mode": "deferred",
      "max_delay": 86400
    },
    "bindings": [
      {
        "name": "CODEMODE_SANDBOX",
        "class_name": "CodemodeSandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["CodemodeSandbox"]
    }
  ]
}
