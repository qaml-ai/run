{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "camelrun-v2-prod",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": [
    "nodejs_compat",
    "enhanced_error_serialization"
  ],
  "vars": {
    "CAMELFS_URL": "https://fs-v2.camelai.dev",
    "DEFAULT_MODEL": "azure/gpt-6.2-sol",
    "TOOL_IDENTITY_ISSUER": "https://run.camelai.com/v2",
    "VOICE_PUBLIC_URL": "https://run.camelai.com",
    "AGENT_PRICE_ELEVENLABS_AGENTS_MINUTE_USD": "0.08",
    "AGENT_PRICE_ELEVENLABS_LLM_MINUTE_USD": "0.001",
    "AGENT_PRICE_ELEVENLABS_GEMINI_3_1_LLM_MINUTE_USD": "0.012",
    "AGENT_PRICE_ELEVENLABS_HAIKU_LLM_MINUTE_USD": "0.003"
  },
  "images": { "binding": "IMAGES" },
  "browser": { "binding": "BROWSER" },
  "services": [{ "binding": "SVG_RENDERER", "service": "camelrun-v2-svg-renderer" }],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "camelrun-v2-prod-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "camelrun-v2-prod-events"
      }
    ],
    "consumers": [
      {
        "queue": "camelrun-v2-prod-events",
        "max_batch_size": 25,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  "durable_objects": {
    "code_update_strategy": {
      "mode": "deferred",
      "max_delay": 86400
    },
    "bindings": [
      {
        "name": "TENANT_DO",
        "class_name": "TenantDO"
      },
      {
        "name": "AGENT_DO",
        "class_name": "AgentDO"
      },
      {
        "name": "VOICE_CALL_DO",
        "class_name": "VoiceCallDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TenantDO",
        "AgentDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "VoiceCallDO"
      ]
    }
  ],
  "account_id": "85bbd288051330fb51ee1c86031a299b",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "run.camelai.com/v2",
      "zone_name": "camelai.com"
    },
    {
      "pattern": "run.camelai.com/v2/*",
      "zone_name": "camelai.com"
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "issues": {
      "enabled": true
    },
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
