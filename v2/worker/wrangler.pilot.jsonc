{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "camelrun-v2-pilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat",
    "enhanced_error_serialization"
  ],
  "vars": {
    "CAMELFS_BACKEND": "cloudflare",
    "CAMELFS_SELF_URL": "https://run-v2-pilot.camelai.dev",
    "CAMELFS_CONTAINER_INSTANCE": "standard-1",
    "DEFAULT_MODEL": "openrouter/meta/muse-ember"
  },
  "images": { "binding": "IMAGES" },
  "services": [{ "binding": "SVG_RENDERER", "service": "camelrun-v2-svg-renderer" }],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "camelrun-v2-pilot-media"
    },
    {
      "binding": "CAMELFS_BUCKET",
      "bucket_name": "camelrun-v2-pilot-camelfs"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "camelrun-v2-pilot-events"
      }
    ],
    "consumers": [
      {
        "queue": "camelrun-v2-pilot-events",
        "max_batch_size": 25,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  "durable_objects": {
    "code_update_strategy": {
      "mode": "deferred",
      "max_delay": 86400
    },
    "bindings": [
      {
        "name": "TENANT_DO",
        "class_name": "TenantDO"
      },
      {
        "name": "AGENT_DO",
        "class_name": "AgentDO"
      },
      {
        "name": "CAMELFS_LINEAGE_DO",
        "class_name": "CamelfsLineageDO"
      },
      {
        "name": "CAMELFS_CONTAINER_DO",
        "class_name": "CamelfsContainerDO"
      }
    ]
  },
  "containers": [
    {
      "name": "camelrun-v2-pilot",
      "class_name": "CamelfsContainerDO",
      "scheduling_policy": "durable_object",
      "images": {
        "camelfs": {
          "dockerfile": "../camelfsd/Dockerfile.cf-container"
        }
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TenantDO",
        "AgentDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "CamelfsLineageDO",
        "CamelfsContainerDO"
      ]
    }
  ],
  "account_id": "85bbd288051330fb51ee1c86031a299b",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "run-v2-pilot.camelai.dev",
      "custom_domain": true
    }
  ]
}
