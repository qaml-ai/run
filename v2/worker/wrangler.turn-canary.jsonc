{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "camelrun-v2-turn-canary",
  "account_id": "85bbd288051330fb51ee1c86031a299b",
  "main": "src/turn-canary.ts",
  "compatibility_date": "2026-03-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CAMELRUN_URL": "https://run.camelai.com/v2"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "issues": { "enabled": true },
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
