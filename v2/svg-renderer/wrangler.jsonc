{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "camelrun-v2-svg-renderer",
  "main": "index.ts",
  "account_id": "85bbd288051330fb51ee1c86031a299b",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "limits": { "cpu_ms": 5000 },
  "observability": { "enabled": true, "head_sampling_rate": 0.01 }
}
