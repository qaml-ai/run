{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "camelrun-v2-ingress",
  "main": "index.ts",
  "compatibility_date": "2026-11-19",
  "account_id": "85bbd288051330fb51ee1c86031a299b",
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    { "binding": "V2", "service": "camelrun-v2-prod" }
  ],
  "routes": [
    { "pattern": "run.camelai.com/*", "zone_name": "camelai.com" },
    { "pattern": "agents.camelai.dev/*", "zone_name": "camelai.dev" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.01 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
