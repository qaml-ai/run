{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "camelrun-v2-ingress",
  "main": "worker.ts",
  "minify": true,
  "compatibility_date": "2026-11-19",
  "account_id": "85bbd288051330fb51ee1c86031a299b",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "../../console/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "AGENT_ADMIN_ACCESS_TEAM": "https://qaml.cloudflareaccess.com",
    "AGENT_ADMIN_ACCESS_AUD": "041fd04d6d1fb5bc79df2e24d35bde86085109e322819cdc0964501ba5bd3478"
  },
  "services": [
    { "binding": "V2", "service": "camelrun-v2-prod" }
  ],
  "routes": [
    { "pattern": "run.camelai.com/*", "zone_name": "camelai.com" },
    { "pattern": "agents.camelai.dev/*", "zone_name": "camelai.dev" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.01 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
