{
  "name": "agent-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server.ts",
    "demo": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/demo.ts",
    "demo:clients": "node --experimental-strip-types --disable-warning=ExperimentalWarning examples/run.ts",
    "demo:typescript": "node --experimental-strip-types --disable-warning=ExperimentalWarning examples/release-board.ts",
    "demo:python": "python3 examples/inventory.py",
    "test": "node --experimental-strip-types --test --test-timeout=120000 tests/*.test.ts",
    "test:shard": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-shard.ts",
    "test:python": "python3 tests/python_sdk.py",
    "typecheck": "tsc -p tsconfig.json && tsc -p studio/tsconfig.json && tsc -p console/tsconfig.json",
    "studio": "node --experimental-strip-types --disable-warning=ExperimentalWarning studio/server.ts",
    "build": "vite build --config studio/vite.config.ts",
    "build:console": "vite build --config console/vite.config.ts",
    "openapi": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/openapi.ts",
    "bench:execute": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bench-execute.ts",
    "bench:js-exec": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bench-js-exec.ts",
    "bench:codemode": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bench-codemode.ts",
    "test:studio": "node --experimental-strip-types --disable-warning=ExperimentalWarning studio/smoke.ts"
  },
  "version": "0.1.0",
  "description": "Hosted agent runtime: supervisor, durable agent state, QuickJS codemode sandbox, SDKs, console and Studio",
  "engines": {
    "node": ">=22.21.0"
  },
  "exports": {
    ".": "./clients/typescript.ts",
    "./node": "./clients/node.ts",
    "./supervisor": "./src/supervisor.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.1139.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.1138.0",
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "hono": "^4.13.8",
    "pg": "^8.13.1",
    "quickjs-emscripten": "0.32.0",
    "sucrase": "^3.35.1",
    "typebox": "1.1.38",
    "undici": "^8.11.2",
    "yaml": "^2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.27",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "8.0.16",
    "ws": "^8.21.3"
  }
}
