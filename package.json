{
  "name": "run",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test --test-timeout=300000 tests/*.test.ts",
    "test:v2": "npm --prefix v2 run test",
    "typecheck": "tsc -p tsconfig.json && tsc -p console/tsconfig.json && tsc -p packages/react/tsconfig.json && tsc -p packages/registry/tsconfig.json && tsc -p packages/bindings.tsconfig.json && tsc -p packages/cli/tsconfig.json",
    "typecheck:v2": "npm --prefix v2 run typecheck",
    "test:ui": "vitest run --config packages/react/vitest.config.ts && vitest run --config packages/registry/vitest.config.ts && vitest run --config packages/bindings.vitest.config.ts && npm run test:console",
    "test:console": "vitest run --config console/vitest.config.ts",
    "build:console": "vite build --config console/vite.config.ts",
    "registry": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/registry/build.ts"
  },
  "version": "0.1.0",
  "description": "CamelRun v2 agent runtime (Cloudflare Workers + Durable Objects, camelfsd, Firecracker jobhost, SDKs)",
  "engines": {
    "node": ">=22.21.0"
  },
  "exports": {
    ".": "./clients/typescript.ts",
    "./node": "./clients/node.ts",
    "./watch": "./clients/watch.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "hono": "^4.13.8",
    "sharp": "0.35.5",
    "typebox": "1.1.38",
    "undici": "^8.11.2",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.121",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.27",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "ai": "^7.0.118",
    "ajv": "^8.17.1",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "0.28.2",
    "express": "^5.2.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.562.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "8.0.16",
    "vitest": "^3.2.7",
    "vue": "^3.5.43"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "ws": "$ws"
  }
}
