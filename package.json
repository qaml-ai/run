{
  "name": "run",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server.ts",
    "demo:clients": "node --experimental-strip-types --disable-warning=ExperimentalWarning examples/run.ts",
    "demo:typescript": "node --experimental-strip-types --disable-warning=ExperimentalWarning examples/release-board.ts",
    "demo:python": "python3 examples/inventory.py",
    "test": "node --experimental-strip-types --test --test-timeout=300000 tests/*.test.ts",
    "test:props": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-timeout=3600000 tests/prop-*.test.ts",
    "test:shard":"node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-shard.ts",
    "test:python": "python3 tests/python_sdk.py",
    "typecheck": "tsc -p tsconfig.json && tsc -p studio/tsconfig.json && tsc -p console/tsconfig.json && tsc -p packages/react/tsconfig.json && tsc -p packages/registry/tsconfig.json && tsc -p packages/bindings.tsconfig.json && tsc -p packages/cli/tsconfig.json",
    "test:ui": "vitest run --config packages/react/vitest.config.ts && vitest run --config packages/registry/vitest.config.ts && vitest run --config packages/bindings.vitest.config.ts && npm run test:console",
    "test:console": "vitest run --config console/vitest.config.ts",
    "registry": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/registry/build.ts",
    "studio": "node --experimental-strip-types --disable-warning=ExperimentalWarning studio/server.ts",
    "build": "vite build --config studio/vite.config.ts",
    "build:console": "vite build --config console/vite.config.ts",
    "openapi": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/openapi.ts",
    "docs": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/docs.ts",
    "reconcile:storage": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/reconcile-storage.ts",
    "bench:execute": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bench-execute.ts",
    "bench:v8-exec": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bench-v8-exec.ts",
    "build:v8-exec": "cd sandbox/v8-exec && cargo build --release",
    "bench:search": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bench-search.ts",
    "bench:codemode": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bench-codemode.ts",
    "test:studio": "node --experimental-strip-types --disable-warning=ExperimentalWarning studio/smoke.ts"
  },
  "version": "0.1.0",
  "description": "Hosted agent runtime: supervisor, durable agent state, V8 codemode sandbox, SDKs, console and Studio",
  "engines": {
    "node": ">=22.21.0"
  },
  "exports": {
    ".": "./clients/typescript.ts",
    "./node": "./clients/node.ts",
    "./watch": "./clients/watch.ts",
    "./supervisor": "./src/supervisor.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1127.0",
    "@aws-sdk/client-ecs": "^3.1139.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.1138.0",
    "@aws-sdk/client-sesv2": "^3.1142.0",
    "@earendil-works/pi-agent-core": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@smithy/node-http-handler": "4.12.1",
    "hono": "^4.13.8",
    "pg": "^8.13.1",
    "postal-mime": "^4.0.0",
    "sharp": "0.35.5",
    "typebox": "1.1.38",
    "undici": "^8.11.2",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.121",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.27",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "ai": "^7.0.118",
    "ajv": "^8.17.1",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.562.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "8.0.16",
    "vitest": "^3.2.7",
    "vue": "^3.5.43",
    "ws": "^8.21.3"
  },
  "license": "AGPL-3.0-only"
}
