{
  "name": "@camelai/run-vue",
  "version": "0.15.0",
  "description": "Vue bindings for chatting with agents on camelRun.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qaml-ai/run.git",
    "directory": "packages/vue"
  },
  "homepage": "https://run.camelai.com",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@camelai/run": "0.15.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  }
}
