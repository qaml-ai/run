# Your API key from https://run.camelai.com/console (keep it server-side: never NEXT_PUBLIC_).
CAMELAI_API_KEY=
# The agent's model, if not the one in app/api/agent/route.ts (any of GET /v1/models?available=true).
# AGENT_MODEL=openrouter/anthropic/claude-sonnet-5.5
# Only to use a runtime other than https://run.camelai.com (e.g. one you run locally).
# CAMELAI_BASE_URL=http://127.0.0.1:8790
# Allow anonymous demo users in production (only for a throwaway demo: see the README).
# DEMO_AUTH=1
