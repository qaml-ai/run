{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@camelai/run": [
        "../../clients/typescript.ts"
      ],
      "@camelai/run/server": [
        "../../clients/server.ts"
      ],
      "@camelai/run/chat": [
        "../../clients/chat.ts"
      ],
      "@camelai/run/markdown": [
        "../../clients/markdown.ts"
      ],
      "@camelai/run/watch": [
        "../../clients/watch.ts"
      ],
      "@camelai/run/ai-sdk": [
        "../../clients/ai-sdk.ts"
      ],
      "@camelai/run-react": [
        "../react/src/index.tsx"
      ],
      "@camelai/run-react/ui": [
        "../react/src/ui/index.tsx"
      ],
      "@/components/ui/button": [
        "./test/stubs/button.tsx"
      ],
      "@/lib/utils": [
        "./test/stubs/utils.ts"
      ]
    }
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./test/**/*.ts",
    "./test/**/*.tsx",
    "./vitest.config.ts",
    "./build.ts"
  ]
}
