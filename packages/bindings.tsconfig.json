{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2024",
      "DOM"
    ],
    "paths": {
      "@camelai/run": [
        "../clients/typescript.ts"
      ],
      "@camelai/run/server": [
        "../clients/server.ts"
      ],
      "@camelai/run/chat": [
        "../clients/chat.ts"
      ],
      "@camelai/run/markdown": [
        "../clients/markdown.ts"
      ],
      "@camelai/run/watch": [
        "../clients/watch.ts"
      ],
      "@camelai/run/ai-sdk": [
        "../clients/ai-sdk.ts"
      ]
    }
  },
  "include": [
    "./vue/src/**/*.ts",
    "./vue/test/**/*.ts",
    "./svelte/src/**/*.ts",
    "./svelte/test/**/*.ts",
    "./solid/src/**/*.ts",
    "./solid/test/**/*.ts",
    "./test-lifecycle.ts",
    "./bindings.vitest.config.ts"
  ]
}
