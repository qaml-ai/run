# Non-secret runtime settings. Secrets (session secret, tenants) come from Secrets Manager.
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_PROCESSES=16
AGENT_IDLE_MS=300000
AGENT_TOOL_TIMEOUT_MS=60000
AGENT_PUBLIC_URL=https://agents.camelai.dev
GITHUB_ORG=qaml-ai
AGENT_MAX_PROCESSES_PER_TENANT=8
# Durable state in S3 (bucket from infra/terraform); leases default to S3 conditional writes.
AGENT_STORAGE=s3
AGENT_S3_BUCKET=camelai-agent-runtime-state
AGENT_S3_PREFIX=agents
AWS_REGION=us-west-2
# Many agents per process; model-written code still runs in its own sandbox process.
AGENT_HOSTING=inline
# Control-plane Postgres (infra/terraform rds.tf). The runtime reads the RDS-managed,
# rotating credentials from this secret itself and verifies TLS against the RDS CA.
AGENT_DATABASE_HOST=camelai-agent-runtime-control.c7iww4ik2152.us-west-2.rds.amazonaws.com
AGENT_DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-west-2:904534089871:secret:rds!db-6669f17b-40c2-4f3a-8122-19544f8e70ea-vQx0Os
AGENT_DATABASE_CA=/etc/ssl/rds-global-bundle.pem
