# Cutover only (infra/terraform/README.md, "Cutover from the EC2 host", step 3):
# the old host stops serving and forwards everything to the ECS service's ALB,
# so clients that still resolve the Elastic IP keep working while DNS moves.
# RUNTIME_HOSTNAME and ALB_DNS_NAME are replaced when it is installed.
{
  admin off
  log {
    output discard
  }
}

RUNTIME_HOSTNAME {
  log {
    output discard
  }
  # The ALB's certificate is for RUNTIME_HOSTNAME, so present and verify that
  # name, and keep the client's Host header. SSE: flush every event.
  reverse_proxy https://ALB_DNS_NAME {
    header_up Host {host}
    flush_interval -1
    transport http {
      tls_server_name RUNTIME_HOSTNAME
    }
  }
}
