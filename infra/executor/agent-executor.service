[Unit]
Description=camelAI code executor (one gVisor sandbox per execution)
After=network-online.target
Wants=network-online.target
# user-data.sh writes these at first boot.
ConditionPathExists=/etc/agent-executor/executor.env
ConditionPathExists=/opt/agent-executor/app/src/executor/server.ts

[Service]
# Unprivileged: the only root it can reach is the sandbox helper, through sudo.
# Mount-namespace hardening (ProtectSystem, PrivateTmp, ...) and NoNewPrivileges
# would carry over to the helper and runsc, or break sudo, so they are not set here.
User=agent-executor
Group=agent-executor
EnvironmentFile=/etc/agent-executor/executor.env
Environment=AGENT_EXECUTOR_SANDBOX=runsc HOST=0.0.0.0 PORT=8790
WorkingDirectory=/opt/agent-executor/app
# `+`: as root. Egress rules for this user, then any sandboxes a previous run left.
ExecStartPre=+/usr/sbin/nft -f /etc/agent-executor/egress.nft
ExecStartPre=+/usr/local/libexec/agent-executor/sandbox gc
ExecStart=/opt/node/bin/node --experimental-strip-types --disable-warning=ExperimentalWarning src/executor/server.ts
ProtectHome=yes
Restart=always
RestartSec=2
# Running executions end with their runtime's deadline (at most 120s).
TimeoutStopSec=130
StandardOutput=append:/var/log/agent-executor/executor.log
StandardError=append:/var/log/agent-executor/executor.log

[Install]
WantedBy=multi-user.target
