# Runtime source revision; use a revision containing the nested-KVM launcher flags.
RUN_REF=main
# Daemon source revision: choose a ref containing the camelfsd egress subcommand.
# A branch rebuilds the binary and restarts both camelfsd services when it moves.
CAMELFSD_REF=main
# Runtime enrollment endpoint, e.g. https://run-pilot.camelai.dev (required).
RUNTIME_URL=
# aws uses the instance role; test needs JOB_HOST_TEST_SECRET in /etc/camel/jobhost-test.env.
ATTESTOR=aws
# Runtime scheduling pool: test or build.
POOL=test
# Maximum concurrent jobs.
SLOTS=1
# Advertised total host CPU capacity, not a per-guest allocation.
JOB_VCPUS=2
# Advertised total host memory capacity in MiB, not a per-guest allocation.
JOB_MEMORY_MIB=2048
# camelfsd's runtime API (bearer from /etc/camel/camelfs-api.env), on host loopback; the tunnel points here.
CAMELFS_API_PORT=8790
# Daemon object store URL (required; replace both placeholders).
CAMELFSD_STORE='s3://<bucket>/camelfsd/<prefix>'
# A new lineage's blank image size in bytes: sparse, so a high default costs nothing up front (no proactive caps). 64 GiB:
# mkfs writes ~0.5 GB of inode tables at this size unless the daemon's mkfs uses lazy init (unit 7 does). There is
# no online grow yet (ledger L67), so this is the most a job's /repo can hold.
CAMELFSD_VIRTUAL_SIZE=68719476736
# Region of the daemon store and AWS environment.
AWS_REGION=us-west-2
# Empty discovers instance store by model; an override still requires safety checks.
NVME_DEVICE=
# Optional artifact location; defaults to CAMELFSD_STORE.
GUEST_IMAGE_S3_PREFIX=

# Enable the Go session control plane only on hosts configured for tier mTLS and the image bucket.
# Leave empty for storage-only hosts.
# CAMELFSD_COMPUTE_FLAGS="--compute --tier-hosts-endpoint fs-internal.camelai.dev:8794 --tier-enroll-url https://fs.camelai.dev:8443 --pool test --slots 2 --vcpus 2 --memory-mib 4096 --disk-mib 8192 --images-store s3://<bucket>"
