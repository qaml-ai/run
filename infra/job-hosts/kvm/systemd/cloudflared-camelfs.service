[Unit]
Description=camelFS API Cloudflare Tunnel
Wants=network-online.target
After=network-online.target camelfsd.service

[Service]
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run --token-file /etc/cloudflared/camelfs.token
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
