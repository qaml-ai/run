[Unit]
Description=camelRun job egress proxy (job VMs' only way out)
After=camel-kvm-prep.service nftables.service
Requires=camel-kvm-prep.service nftables.service

[Service]
# Its own user: the base rules keep this uid's traffic to public addresses on 443 (and Amazon's DNS).
User=camel-proxy
Group=camel-proxy
ExecStart=/usr/local/bin/camelfsd egress --policies /run/camel/egress --listen 0.0.0.0
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/run/camel/egress
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
