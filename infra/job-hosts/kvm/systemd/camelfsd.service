[Unit]
Description=camelFS daemon
Wants=network-online.target
After=network-online.target camel-kvm-prep.service
Requires=camel-kvm-prep.service

[Service]
Environment=AWS_REGION=us-west-2 CAMELFSD_VIRTUAL_SIZE=17179869184
EnvironmentFile=/etc/camel/kvm-host.conf
ExecStartPre=/usr/local/sbin/camelfsd-cleanup
ExecStart=/usr/local/bin/camelfsd host --socket /run/camelfsd/api.sock --data /nvme/camelfs --store ${CAMELFSD_STORE} --region ${AWS_REGION} --virtual-size ${CAMELFSD_VIRTUAL_SIZE}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
