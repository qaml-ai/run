[Unit]
Description=camelFS daemon
Wants=network-online.target
After=network-online.target camel-kvm-prep.service
Requires=camel-kvm-prep.service

[Service]
Environment=AWS_REGION=us-west-2 CAMELFSD_VIRTUAL_SIZE=68719476736
Environment=TIER_CA=/etc/camel/tier-ca.pem LISTEN_COMPUTE=0.0.0.0:8792 POOL=test SLOTS=1 JOB_VCPUS=2 JOB_MEMORY_MIB=2048 CAMELFSD_DISK_MIB=8192
EnvironmentFile=/etc/camel/kvm-host.conf
# camelfsd host is the compute host only (the /v0 socket API and storage-only mode were removed in unit 11).
ExecStart=/bin/sh -ec 'if [ -z "$${TIER_ENROLL_URL:-}" ] || [ -z "$${TIER_HOSTS_ENDPOINT:-}" ]; then \
        echo "camelfsd host is the compute host: set TIER_ENROLL_URL and TIER_HOSTS_ENDPOINT (kvm-host.conf.example)" >&2; exit 1; fi; \
    exec /usr/local/bin/camelfsd host --data /nvme/camelfs --store "$$CAMELFSD_STORE" --region "$$AWS_REGION" \
        --virtual-size "$$CAMELFSD_VIRTUAL_SIZE" --compute --tier-enroll-url "$$TIER_ENROLL_URL" \
        --tier-hosts-endpoint "$$TIER_HOSTS_ENDPOINT" --tier-ca "$${TIER_CA:-/etc/camel/tier-ca.pem}" --pool "$$POOL" \
        --images-store "$${CAMELFSD_IMAGES_STORE:?}" --listen-compute "$${LISTEN_COMPUTE:-0.0.0.0:8792}" --slots "$$SLOTS" \
        --vcpus "$$JOB_VCPUS" --memory-mib "$$JOB_MEMORY_MIB" --disk-mib "$$CAMELFSD_DISK_MIB"'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
