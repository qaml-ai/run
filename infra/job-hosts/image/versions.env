# Pinned inputs of the job host image (infra/job-hosts/image). check-image.sh and host-setup.sh read this file.
# Firecracker: the release tarball and the binary in it, from the release's own sha256 files (v1.18.0, aarch64).
FIRECRACKER_VERSION=v1.18.0
FIRECRACKER_TGZ_SHA256=2a6130ff0338901ff9d7fbd73ce046c6b1c6123889dc84a34d678aa53bd0c0c2
FIRECRACKER_BIN_SHA256=6f9e08df0a0072e3e7086c51ff434c034d705845e349175a01beb3f9cc025ce3
# Nitro Sandboxes: PCIe slots for sandboxes (36 of 80 on an r8gd.4xlarge, the spike's) and the memory pool reserved at
# boot, per pool (build hosts give most of their memory to their sandbox; test hosts less).
NE_PCIE_SLOTS=36
NE_MEMPOOL_BUILD=100G
NE_MEMPOOL_TEST=24G
# The guest root image's size before a job grows its clone (GiB).
GUEST_IMAGE_GIB=6
