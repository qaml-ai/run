{
  "$schema":"../../node_modules/wrangler/config-schema.json",
  "name":"camelrun-proto-platform-files",
  "main":"worker.ts",
  "compatibility_date":"2026-11-05",
  "compatibility_flags":["nodejs_compat"],
  "workers_dev":true,
  "preview_urls":false,
  "durable_objects":{"bindings":[{"name":"VOLUMES","class_name":"Volume"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["Volume"]}],
  "r2_buckets":[{"binding":"BUCKET","bucket_name":"camelrun-proto-platform-files"}],
  "observability":{"enabled":true}
}
