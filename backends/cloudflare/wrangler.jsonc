{
  "name": "camelrun-cloudflare-prototype",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [{ "name": "AGENTS", "class_name": "CamelAgent" }, { "name": "DIRECTORY", "class_name": "AgentDirectory" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CamelAgent", "AgentDirectory"] }],
  "vars": { "MODEL": "@cf/zai-org/glm-5.3-flash" }
}
