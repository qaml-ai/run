{
  "name": "camelrun-proto-hybrid-images",
  "account_id": "85bbd288051330fb51ee1c86031a299b",
  "main": "worker.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "limits": {"cpu_ms": 30000},
  "images": {"binding": "IMAGES"},
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "camelrun-proto-hybrid-images"}],
  "worker_loaders": [{"binding": "LOADER"}],
  "durable_objects": {"bindings": [
    {"name": "CASES", "class_name": "camelrun-proto-hybrid-images"},
    {"name": "AGENTS", "class_name": "camelrun-proto-hybrid-images"}
  ]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["camelrun-proto-hybrid-images"]}],
  "vars": {"MODEL": "test/echo", "TEST_MODEL": "1"}
}
