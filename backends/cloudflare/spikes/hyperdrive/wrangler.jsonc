{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "camelrun-proto-hybrid-hyperdrive",
  "main": "worker.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "CREDITS", "class_name": "CreditsProbe" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CreditsProbe"] }],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
  "observability": { "enabled": false },
  "dev": { "ip": "127.0.0.1", "port": 8797 }
}
