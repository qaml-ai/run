{
  "name": "camelrun-proto-agent-local",
  "main": "agent-worker.local.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "worker_loaders": [{"binding": "LOADER"}],
  "durable_objects": {"bindings": [
    {"name": "AGENTS", "class_name": "LocalRealAgent"},
    {"name": "DIRECTORY", "class_name": "LocalRealDirectory"},
    {"name": "BENCH_AGENTS", "class_name": "LocalDeterministicAgent"},
    {"name": "BENCH_DIRECTORY", "class_name": "LocalDeterministicDirectory"},
    {"name": "BENCH_BUDGET", "class_name": "LocalModelBudget"},
    {"name": "CODEMODE_SANDBOX", "class_name": "CodemodeSandbox", "script_name": "camelrun-codemode-prototype"}
  ]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": [
    "LocalRealAgent", "LocalRealDirectory", "LocalDeterministicAgent",
    "LocalDeterministicDirectory", "LocalModelBudget"
  ]}],
  "vars": {
    "MODEL": "@cf/zai-org/glm-5.3-flash", "BENCH_ENABLED": "1", "BENCH_BUILD": "local",
    "BENCH_MAX_MODEL_CALLS": "24", "API_TOKEN": "local-integration-only-token-with-at-least-32-characters"
  }
}
