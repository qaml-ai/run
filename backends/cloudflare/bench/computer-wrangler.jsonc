{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "camelrun-proto-computers",
  "account_id": "85bbd288051330fb51ee1c86031a299b",
  "main": "computer-entry.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": true, "traces": {"enabled": true}},
  "limits": {"cpu_ms": 30000},
  "durable_objects": {"bindings": [
    {"name":"NATIVE", "class_name":"camelrun-proto-computer-native"},
    {"name":"SANDBOX", "class_name":"camelrun-proto-computer-sdk"}
  ]},
  "migrations": [{"tag":"camelrun-proto-v1", "new_sqlite_classes":["camelrun-proto-computer-native","camelrun-proto-computer-sdk"]}],
  "containers": [
    {"name":"camelrun-proto-computer-native", "class_name":"camelrun-proto-computer-native", "scheduling_policy":"durable_object", "images":{"workspace":{"dockerfile":"computer-Dockerfile","build_context":"computer-fixtures"}}},
    {"name":"camelrun-proto-computer-sdk", "class_name":"camelrun-proto-computer-sdk", "scheduling_policy":"durable_object", "images":{"workspace":{"dockerfile":"computer-Dockerfile","build_context":"computer-fixtures"}}}
  ],
  "r2_buckets": [{"binding":"BACKUPS", "bucket_name":"camelrun-proto-computer-backups"}]
}
