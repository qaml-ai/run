{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "camelrun-proto-bench-basic",
  "account_id": "85bbd288051330fb51ee1c86031a299b",
  "main": "entry.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 30000 },
  "ai": { "binding": "AI" },
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": { "bindings": [
    { "name": "AGENTS", "class_name": "camelrun-proto-bench-basic-agent" },
    { "name": "DIRECTORY", "class_name": "camelrun-proto-bench-basic-directory" },
    { "name": "MACHINE", "class_name": "camelrun-proto-bench-basic-computer" }
  ] },
  "migrations": [{ "tag": "camelrun-proto-bench-v1", "new_sqlite_classes": [
    "camelrun-proto-bench-basic-agent", "camelrun-proto-bench-basic-directory", "camelrun-proto-bench-basic-computer"
  ] }],
  "containers": [{
    "name": "camelrun-proto-bench-basic-computer",
    "class_name": "camelrun-proto-bench-basic-computer",
    "scheduling_policy": "durable_object",
    "images": { "workspace": { "dockerfile": "Dockerfile", "build_context": "." } }
  }],
  "vars": { "MODEL": "@cf/zai-org/glm-5.3-flash" }
}
