{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "camelrun-proto-bench-s4-worker",
  "account_id": "85bbd288051330fb51ee1c86031a299b",
  "main": "s4.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ai": {
    "binding": "AI"
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENTS",
        "class_name": "camelrun-proto-bench-s4-agent"
      },
      {
        "name": "DIRECTORY",
        "class_name": "camelrun-proto-bench-s4-directory"
      },
      {
        "name": "MACHINE",
        "class_name": "camelrun-proto-bench-s4-machine"
      }
    ]
  },
  "migrations": [
    {
      "tag": "camelrun-proto-bench-s4-v1",
      "new_sqlite_classes": [
        "camelrun-proto-bench-s4-agent",
        "camelrun-proto-bench-s4-directory",
        "camelrun-proto-bench-s4-machine"
      ]
    }
  ],
  "vars": {
    "MODEL": "@cf/zai-org/glm-5.3-flash"
  },
  "containers": [
    {
      "name": "camelrun-proto-bench-s4-container",
      "class_name": "camelrun-proto-bench-s4-machine",
      "scheduling_policy": "durable_object",
      "images": {
        "workspace": {
          "dockerfile": "../basic/Dockerfile",
          "build_context": "../basic"
        }
      }
    }
  ]
}
