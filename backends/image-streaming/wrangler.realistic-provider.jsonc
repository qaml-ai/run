{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camelrun-proto-image-realistic-provider",
  "main": "src/fake-provider.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ALLOWED_IMAGE_ORIGIN": "https://camelrun-proto-image-realistic.miguel-85b.workers.dev"
  }
}
