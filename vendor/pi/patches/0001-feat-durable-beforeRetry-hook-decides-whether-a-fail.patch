+/**
+ * The deadline of the next attempt after `failed`, or `undefined` to end the run: the first `beforeRetry` decision, or
+ * else `settings.retry`'s, which `policyRetries` says. A hook's retry without a delay waits the policy's backoff.
+ */
+async function retryDeadline(
+	runtime: Runtime,
+	failed: Omit<FailedAttempt, "delayMs">,
+	policyRetries: boolean,
+	context: Context,
+): Promise<number | undefined> {
+	const backoff = retryDelayMs(runtime.settings.retry, failed.attempt);
+	const asked: FailedAttempt = policyRetries ? { ...failed, delayMs: backoff } : failed;
+	let decision: RetryDecision | undefined;
+	await runtime.hooks.each("beforeRetry", async (hook) => {
+		if (decision !== undefined) return;
+		const decided = await hook(asked, runtime, context);
+		// Extension code: a delay that is not a time to wait is reported, and the next hook or the policy decides.
+		if (
+			decided?.retry === true &&
+			decided.delayMs !== undefined &&
+			!(Number.isFinite(decided.delayMs) && decided.delayMs >= 0)
+		) {
+			throw new RangeError(`beforeRetry returned an invalid delayMs: ${String(decided.delayMs)}`);
+		}
+		decision = decided;
+	});
+	if (decision === undefined) return policyRetries ? runtime.now() + backoff : undefined;
+	return decision.retry ? runtime.now() + (decision.delayMs ?? backoff) : undefined;
+}
