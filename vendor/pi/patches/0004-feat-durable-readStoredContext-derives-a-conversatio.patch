+	it("reads the same context from Storage alone, also as of an earlier entry", async () => {
+		const storage = new MemoryStorage();
+		const { harness } = await openHarness(storage);
+		const root = await harness.root(context);
+		const append = (draft: EntryDraft) => root.commit((tx) => tx.appendEntry(root.id, draft), context);
+		const first = await append({ kind: "message", model: [user("first")] });
+		const call = await append({ kind: "message", model: [assistant("calling", { calls: ["x"] })] });
+		await append({ kind: "message", model: [toolResult("x")] });
+		await append({ kind: "edit", edits: [{ target: first.id, action: "replace", messages: [user("first v2")] }] });
+		const reset = await append({ kind: "reset", head: "self", model: [user("fresh start")] });
+		await append({ kind: "message", model: [assistant("after reset")] });
+
+		expect(await readStoredContext(storage, root.id, context)).toEqual(await root.context(context));
+		for (const at of [first.id, call.id, reset.id]) {
+			expect(await readStoredContext(storage, root.id, context, { at })).toEqual(
+				await root.context(context, { at }),
+			);
+		}
+		const other = await root.fork(first.id, { ownership: { kind: "ownerless" } }, context);
+		await expect(readStoredContext(storage, other.id, context, { at: reset.id })).rejects.toThrow("is not visible");
+		const empty = await harness.createConversation({ ownership: { kind: "ownerless" } }, context);
+		expect(await readStoredContext(storage, empty.id, context)).toEqual(await empty.context(context));
+		await harness.close(context);
+	});
