 const MISSING_RESULT_TEXT = "Tool result unavailable: history ends before this call completed.";
 
+/** The Storage reads a context derivation makes. */
+export type ContextStorage = Pick<Storage, "entry" | "findLatestHeadMarker" | "scanEntries">;
+
+/**
+ * Committed context of one conversation, read from Storage alone: the view `Conversation.context()` returns, with `at`
+ * as there, for a reader without a Harness, such as a process that forks or shows a session another process drives.
+ * Entries at or below the context's tail never change, so entries appended meanwhile do not change the view.
+ */
+export async function readStoredContext(
+	storage: ContextStorage,
+	conversationId: ConversationId,
+	context: Context,
+	options?: { readonly at?: EntryId },
+): Promise<ContextView> {
+	const bounds = await captureContextBounds(storage, conversationId, context, options?.at);
+	return deriveContext(storage, conversationId, bounds, context);
+}
