+/** Whether failed attempts that are asked again stay in the transcript (`settings.retry.keepRetried`). */
+function keepsRetried(runtime: Runtime): boolean {
+	return runtime.settings.retry.keepRetried !== false;
+}
+
+/** Append a failed attempt that is asked again, or with `keepRetried` off record only its usage. */
+async function appendRetried(tx: Tx, runtime: Runtime, message: AssistantMessage): Promise<void> {
+	if (keepsRetried(runtime)) await appendAssistant(tx, runtime.conversationId, message);
+	else await recordModelUsage(tx, runtime.conversationId, message);
+}
+
+/** Record only the usage of a committed partial whose interrupted attempt is asked again with `keepRetried` off. */
+async function dropPartial(tx: Tx, live: Draft<LiveState>, conversationId: ConversationId): Promise<void> {
+	const partial = live.generation?.message;
+	if (partial === undefined) return;
+	await recordModelUsage(tx, conversationId, copyJson(partial) as unknown as AssistantMessage);
+}
