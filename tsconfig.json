{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@camelai/run": ["./clients/typescript.ts"],
      "@camelai/run/*": ["./clients/*.ts"]
    }
  },
  "include": ["tests/**/*.ts", "clients/**/*.ts", "jobhost/**/*.ts"]
}
