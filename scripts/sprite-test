#!/usr/bin/env bash
# sprite-test [options] [ref] [command...]: run camelRun tests at <ref> on the rt-pool sprites (sprites.dev, Fly.io).
#   scripts/sprite-test                                   # the full suite at HEAD (sim files included, as CI runs them), as 8 shards on 8 sprites
#   scripts/sprite-test origin/fix/x                      # the full suite at a ref
#   scripts/sprite-test HEAD npm run typecheck             # any command, in the checkout
#   scripts/sprite-test --dirty HEAD npm run build         # the working tree, without secrets, as a temporary commit
#   scripts/sprite-test --targeted tests/clients.test.ts   # node --test on chosen files
#   scripts/sprite-test --shards=3 HEAD bash backends/workers/scripts/validate-sprite.sh integration '{shard}/{shards}'
#   scripts/sprite-test --help                            # every option and setting
#   --contract-baselines                                  # (this repo) include validated local Node report caches
#
# This file is only camelRun's configuration. The machinery (leases, sync, Node 22, Docker, Postgres, the job) is
# scripts/sprite-test-core.sh next to it, the same core camel-bots keeps a copy of (keep the two the same). Each sprite
# keeps a checkout in ~/rt with node_modules and the v8-exec build; a run gets a fresh Postgres 16 container (as
# .github/actions/test-postgres), and Docker for the Workers backend's native container tests
# (backends/workers/README.md, "Docker on a sprite").
core=$(dirname "${BASH_SOURCE[0]}")/sprite-test-core.sh

# The core features this configuration uses; a core without one of them stops here (tests/sprite-test.test.ts checks
# the same).
sprite_requires="leases dirty-denylist shards artifacts targeted hooks docker postgres-docker node22 check-core"
sprite_prefix=rt-pool- sprite_pool=42 sprite_shards=8 sprite_dir=rt
sprite_keep="node_modules/ /sandbox/v8-exec/target/"
sprite_build_path=sandbox/v8-exec
sprite_apt=""
sprite_pg_env=AGENT_TEST_DATABASE_URL
sprite_sha_env=CONTRACT_REVISION
# The v8-exec binary is rebuilt unless target/release/.sources names this tree's sandbox/v8-exec and the binary's own
# hash, whatever built it last: a sprite once ran a stale binary while markers said it was current. cargo goes by mtimes,
# and rsync gives files their commit times (an older ref's sources look older than the build), so the crate is cleaned
# first.
read -r -d '' sprite_prepare <<'PREPARE' || true
bin=sandbox/v8-exec/target/release/v8-exec; built=sandbox/v8-exec/target/release/.sources
[ -x "$bin" ] && [ "$(cat "$built" 2>/dev/null)" = "$build $(sha256sum < "$bin" | cut -d' ' -f1)" ] || { echo '== building v8-exec (sandbox/v8-exec changed)'
  rm -f "$built"; (cd sandbox/v8-exec && cargo clean -q --release -p v8-exec) && npm run -s build:v8-exec >/dev/null && sync \
    && [ -x "$bin" ] && echo "$build $(sha256sum < "$bin" | cut -d' ' -f1)" > "$built"; } || { echo "== building v8-exec failed"; exit 1; }
[ -x "$bin" ] || { echo "== $bin is missing or not executable"; exit 1; }
PREPARE
sprite_default_job() { echo "env TEST_DATABASE_PER_FILE=true TEST_CONCURRENCY=6 TEST_INCLUDE_SIM=true npm run -s test:shard -- $1/$2"; }

contract_baselines=0
sprite_option() { [[ $1 == --contract-baselines ]] && contract_baselines=1; }
sprite_tree() { # <tree>: --contract-baselines adds the validated local Node report caches, and nothing else
  (( contract_baselines )) || return 0
  node --input-type=module - "$PWD/backends/workers/measurements/node-baselines" "$1/backends/workers/measurements/node-baselines" <<'JS'
import { lstat, readdir, readFile, mkdir, writeFile } from "node:fs/promises";
import path from "node:path";
const [source, destination] = process.argv.slice(2);
const info = await lstat(source).catch(error => { if (error.code === "ENOENT") return null; throw error; });
if (info && (!info.isDirectory() || info.isSymbolicLink())) throw new Error("Contract baseline cache must be a real directory");
await mkdir(destination, { recursive: true });
for (const name of info ? await readdir(source) : []) {
  if (!/^[a-f0-9]{64}\.json$/.test(name)) continue;
  const filename = path.join(source, name), entry = await lstat(filename);
  if (!entry.isFile() || entry.isSymbolicLink()) throw new Error(`Contract baseline must be a regular file: ${name}`);
  const bytes = await readFile(filename), report = JSON.parse(bytes);
  if (report.backend !== "node" || report.nodeKey !== name.slice(0, -5) || !Array.isArray(report.rows)) throw new Error(`Invalid Node baseline cache: ${name}`);
  // The contract runner separately verifies the current source key, selected
  // case identities, unique inventory and all statuses before trusting it.
  await writeFile(path.join(destination, name), bytes);
}
JS
}

source "$core" "$@"
