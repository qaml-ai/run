{
  // Throwaway benchmark deployment on the pilot account. Never the pilot Worker.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cfork-bench",
  "main": "worker.ts",
  "account_id": "85bbd288051330fb51ee1c86031a299b",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "MACHINES", "class_name": "Machine" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Machine"] }],
  "containers": [{
    "name": "cfork-bench",
    "class_name": "Machine",
    "scheduling_policy": "durable_object",
    "images": { "workspace": { "dockerfile": "./Dockerfile" } }
  }]
}
