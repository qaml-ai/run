# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32, or fill every empty one at once:
#   for v in AGENT_OPERATOR_TOKEN AGENT_SESSION_SECRET AGENT_SECRETS_KEY POSTGRES_PASSWORD; do
#     sed -i.bak "s/^$v=$/$v=$(openssl rand -hex 32)/" .env; done; rm .env.bak

# The Compose project: its containers and volumes are named after it. Keep it once set: another name starts empty.
COMPOSE_PROJECT_NAME=agent-runtime

# The runtime's image: a release (see docs/operations/release-notes.md). Upgrade by changing it, then docker compose up -d.
# AGENT_RUNTIME_IMAGE=ghcr.io/qaml-ai/run:0.7.0

# The tenant this runtime serves, and its operator token (at least 24 characters): the
# bearer token your application sends. Keep it secret. It never signs in to the console: give the tenant an email
# and password with it instead (docs/operations/self-host.md, "Sign in to the console").
AGENT_TENANT=selfhost
AGENT_OPERATOR_TOKEN=

# Its provider keys, as JSON, e.g. {"anthropic":"sk-ant-...","openrouter":"sk-or-..."}.
# Optional: keys can also be stored later with PUT /v1/providers/:provider/key.
AGENT_TENANT_API_KEYS=

# Session signing, and encryption of stored keys and secrets. Changing either invalidates what uses it.
AGENT_SESSION_SECRET=
AGENT_SECRETS_KEY=

# Where your application and tool servers reach the runtime. Private (the default here): its address on
# the Compose network, and browsers read through your application, so browser tokens name no URL.
AGENT_PUBLIC_URL=http://runtime:8790
AGENT_BROWSER_URL=
# Or public, behind your reverse proxy: AGENT_PUBLIC_URL=https://agents.example.com, and no AGENT_BROWSER_URL line.

POSTGRES_PASSWORD=

# The port and address the runtime listens on, on this host (default 127.0.0.1:8790; 0.0.0.0 for every interface).
# AGENT_RUNTIME_PORT=8790
# AGENT_RUNTIME_BIND=127.0.0.1

# The default model, for agents that name none (see docs/operations/configuration.md).
# AGENT_PROVIDER=anthropic
# AGENT_MODEL=claude-sonnet-5-5

# Your own services the runtime calls on a private network (your application's tool server, vLLM, Ollama, a
# gateway): their exact origins, over http too. Nothing else on those hosts is reachable, and web_fetch never is.
# AGENT_OUTBOUND_ALLOW_ORIGINS=http://app:3000,http://10.1.2.3:8000

# Storage: the /data volume by default. For S3 or an S3-compatible service instead
# (`docker compose --profile s3 up -d` runs SeaweedFS; for R2 or another service, give its endpoint and keys):
# AGENT_STORAGE=s3
# AGENT_S3_BUCKET=agent-runtime
# AGENT_S3_ENDPOINT=http://s3:8333
# AGENT_S3_FORCE_PATH_STYLE=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=agent-runtime
# AWS_SECRET_ACCESS_KEY=

# Sign-up, password reset and adding a password by email (docs/operations/account-email.md). Off unless set.
# Through Amazon SES with the AWS credentials and region above (so not with S3-compatible storage's keys there):
# AGENT_ACCOUNT_EMAIL_FROM=accounts@example.com
# AGENT_OPEN_SIGNUP=true            # anyone who reaches the runtime may then make an account
# Or no mail: each link and its address go to the log for you to pass on (resets; sign-up only on localhost).
# AGENT_ACCOUNT_EMAIL_PROVIDER=log
