{
  "name": "@camelai/agent-runtime",
  "version": "0.3.0",
  "description": "SDK for the camelAI hosted agent runtime: define tools in your app, and the runtime runs the model loop, history and sandbox.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qaml-ai/agent-runtime.git",
    "directory": "sdk"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/clients/typescript.d.ts",
      "default": "./dist/clients/typescript.js"
    },
    "./node": {
      "types": "./dist/clients/node.d.ts",
      "default": "./dist/clients/node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "typebox": "1.1.38"
  },
  "homepage": "https://agents.camelai.dev"
}
